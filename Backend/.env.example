PORT = 5000

MONGODB_URI = mongodb+srv://<username>:<password>@<cluster-url>/?appName=Cluster0
DB_NAME = LIBHUB

JWT_SECRET = change-this-to-a-long-random-string
JWT_EXPIRES_IN = 7d

CLIENT_URL = http://localhost:4200

# Optional - only needed if you want real emails for verification / reset password.
# If left blank, the app logs the verification/reset link to the console instead
# so you can still test the flow locally.
EMAIL_HOST =
EMAIL_PORT = 587
EMAIL_USER =
EMAIL_PASS =
EMAIL_FROM = LibHub <no-reply@libhub.com>
